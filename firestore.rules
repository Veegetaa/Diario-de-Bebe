rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidDiaryCode(code) {
      return code is string && code.size() >= 3 && code.size() <= 128 && code.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Shared family diaries accessible via authenticated users or family code
    match /diaries/{diaryCode} {
      allow read, write: if request.auth != null || isValidDiaryCode(diaryCode);

      // Records inside the family diary
      match /records/{recordId} {
        allow read: if request.auth != null || isValidDiaryCode(diaryCode);
        allow write: if (request.auth != null || isValidDiaryCode(diaryCode)) && isValidId(recordId);
      }
    }

    // Direct Family Account authentication mapping
    match /family_accounts/{accountKey} {
      allow read: if true;
      allow write: if isValidId(accountKey);
    }
  }
}
